---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';

import Navbox from '../../components/docs/Navbox.astro';
import type { DocNav } from '../../mods/types.ts';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = (async () => {
  const entries = await getCollection('docs');

  return entries.map((entry) => ({
    params: { path: entry.id === 'index' ? undefined : entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);

const navs = import.meta.glob<DocNav>('../../mods/*/*/navbox.ts', {
  eager: true,
  import: 'default',
});

const navPath = entry.id.split('/').slice(0, 2).join('/');
const nav = navs[`../../mods/${navPath}/navbox.ts`];
---

<Base title={entry.data.title} showBanner={false}>
  <div
    id="cofh-docs-content"
    class="uk-width-1-1 uk-width-medium-3-4 uk-container-center"
    data-pagefind-body
  >
    <h1>{entry.data.title}</h1>
    <hr />

    <Content />

    {nav !== undefined && (
      <div
        class="uk-width-1-1 uk-width-medium-5-6 uk-container-center"
        style="margin-top: 65px"
        data-pagefind-ignore="all"
      >
        <Navbox nav={nav} path={navPath} />
      </div>
    )}
  </div>
</Base>

<style is:global>
  #cofh-docs-content code {
    color: #444444;
  }

  #cofh-docs-content .uk-text-small code {
    font-size: 10.5px;
  }

  #cofh-docs-content .uk-text-danger code {
    color: #d85030 !important;
  }

  #cofh-docs-content a code {
    color: #0077dd;
  }

  #cofh-docs-content a:hover code {
    color: #005599;
  }

  #cofh-docs-content a[href^='http'] {
    color: #4b97d8;
  }

  #cofh-docs-content a[href^='http']:hover {
    color: #29689a;
  }
</style>
