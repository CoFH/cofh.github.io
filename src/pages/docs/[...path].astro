---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';

import DocsBreadcrumb from '../../components/docs/DocsBreadcrumb.astro';
import Navbox from '../../components/docs/Navbox.astro';
import ModDownload from '../../components/mods/ModDownload.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Site from '../../layouts/Site.astro';
import { getModsHref } from '../../lib/mods.ts';
import modList from '../../mods/mod-list.ts';

export const getStaticPaths = (async () => {
  const entries = await getCollection('docs');

  return entries.map((entry) => ({
    params: { path: entry.id === 'index' ? undefined : entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const [mc, modSlug, ...rest] = entry.id.split('/');

const version = modList.find((listVersion) => listVersion.mc === mc);
const versionMods = version?.sections.flatMap((section) => section.mods) ?? [];

const mod = versionMods.find((listMod) => listMod.slug === modSlug);
const isModOverview = version !== undefined && mod !== undefined && rest.length === 0;

const requires = isModOverview
  ? (mod.requires ?? []).map((slug) => ({
      title: versionMods.find((listMod) => listMod.slug === slug)?.title ?? slug,
      href: `${getModsHref(version)}#${slug}`,
    }))
  : [];

const searchMeta: string[] = [];

if (version !== undefined) {
  searchMeta.push('version[data-version]');
}

if (mod !== undefined) {
  searchMeta.push('mod[data-mod]');
}

const tocAppendix = version !== undefined ? [{ slug: 'navigation', text: 'Navigation' }] : [];
---

<Site title={entry.data.title} version={version}>
  <div class:list={['wrap', { 'with-crumbs': version !== undefined }]}>
    {version !== undefined && <DocsBreadcrumb page={entry} version={version} mod={mod} />}

    <div
      data-pagefind-body
      data-pagefind-meta={searchMeta.length > 0 ? searchMeta.join(', ') : undefined}
      data-version={version?.label}
      data-mod={mod?.title}
      data-pagefind-filter={version !== undefined ? `version:${mc}` : undefined}
    >
      {isModOverview ? (
        <>
          <header class="page-head">
            <h1>{entry.data.title}</h1>
          </header>

          <div class="doc-grid">
            <div class="prose">
              <Content />
            </div>

            <aside class="download" aria-labelledby="download-title" data-pagefind-ignore="all">
              <h2 class="download-title overline" id="download-title">
                Download
              </h2>

              <ModDownload mod={mod} requires={requires} />
            </aside>
          </div>
        </>
      ) : (
        <div class="doc-grid">
          <div>
            <header class="page-head">
              <h1>{entry.data.title}</h1>
            </header>

            <TableOfContents headings={headings} appendix={tocAppendix} inline />

            <div class="prose section-numbers subsection-numbers">
              <Content />
            </div>
          </div>

          <TableOfContents headings={headings} appendix={tocAppendix} />
        </div>
      )}
    </div>

    {version !== undefined && (
      <>
        <div class="prose" data-pagefind-ignore="all">
          <h2 id="navigation">Navigation</h2>
        </div>

        <Navbox version={version} currentMod={mod?.slug} />
      </>
    )}
  </div>
</Site>

<style>
  .with-crumbs .page-head {
    padding-top: 14px;
  }

  .download {
    display: flex;
    flex-direction: column;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg);
  }

  .download-title {
    margin: 0 0 8px;
  }
</style>
