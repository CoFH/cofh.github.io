---
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';

import Navbox from '../../components/docs/Navbox.astro';
import docnav from '../../data/docnav.ts';
import Base from '../../layouts/Base.astro';
import { image } from '../../lib/images.ts';

export const getStaticPaths = (async () => {
  const entries = await getCollection('docs');

  return entries.map((entry) => ({
    params: { path: entry.id === 'index' ? undefined : entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);

const itemSpriteSheet = await getImage({ src: image('recipe/item-sprites/sheet.png') });
const navboxIconSheet = await getImage({ src: image('navbox-icon-sheet.png') });

const navScopes: Record<string, keyof typeof docnav> = {
  '1.16/thermal-series': 'thermal-series',
  '1.16/archers-paradox': 'archers-paradox',
  '1.15/cofh-core': 'cofh-core-1.15',
  '1.12/cofh-core': 'cofh-core-1.12',
  '1.12/cofh-world': 'cofh-world-1.12',
  '1.12/thermal-foundation': 'thermal-foundation-1.12',
  '1.12/thermal-expansion': 'thermal-expansion-1.12',
  '1.12/thermal-dynamics': 'thermal-dynamics-1.12',
  '1.12/thermal-cultivation': 'thermal-cultivation-1.12',
  '1.12/thermal-innovation': 'thermal-innovation-1.12',
  '1.12/redstone-arsenal': 'redstone-arsenal-1.12',
  '1.12/vanillaplus-tools': 'vanillaplus-tools-1.12',
  '1.12/vanillaplus-satchels': 'vanillaplus-satchels-1.12',
};

const nav = Object.entries(navScopes).find(
  ([scope]) => entry.id === scope || entry.id.startsWith(`${scope}/`),
)?.[1];
---

<Base title={entry.data.title} showBanner={false}>
  <div
    id="cofh-docs-content"
    class="uk-width-1-1 uk-width-medium-3-4 uk-container-center"
    style={{
      '--cofh-item-sprite-sheet': `url(${itemSpriteSheet.src})`,
      '--cofh-navbox-icon-sheet': `url(${navboxIconSheet.src})`,
    }}
    data-pagefind-body
  >
    <h1>{entry.data.title}</h1>
    <hr />

    <Content />

    {nav !== undefined && (
      <div
        class="uk-width-1-1 uk-width-medium-5-6 uk-container-center"
        style="margin-top: 65px"
        data-pagefind-ignore="all"
      >
        <Navbox nav={docnav[nav]} />
      </div>
    )}
  </div>
</Base>

<style is:global>
  #cofh-docs-content code {
    color: #444444;
  }

  #cofh-docs-content .uk-text-small code {
    font-size: 10.5px;
  }

  #cofh-docs-content .uk-text-danger code {
    color: #d85030 !important;
  }

  #cofh-docs-content a code {
    color: #0077dd;
  }

  #cofh-docs-content a:hover code {
    color: #005599;
  }

  #cofh-docs-content a[href^='http'] {
    color: #4b97d8;
  }

  #cofh-docs-content a[href^='http']:hover {
    color: #29689a;
  }
</style>
