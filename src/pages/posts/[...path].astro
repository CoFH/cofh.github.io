---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';

import Icon from '../../components/Icon.astro';
import Site from '../../layouts/Site.astro';
import { formatPostDate, getPostDate, getPosts, getPostURL } from '../../lib/posts.ts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();

  return posts.map((post, index) => ({
    params: { path: getPostURL(post).slice('/posts/'.length, -1) },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { title, author } = post.data;
const { Content } = await render(post);
---

<Site title={`${title} · Blog`}>
  <div class="wrap reading">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a class="crumb" href="/blog/">
        Blog
      </a>

      <span class="separator">
        <Icon name="chevronRight" />
      </span>

      <span aria-current="page">{title}</span>
    </nav>

    <article aria-labelledby="post-title" data-pagefind-body>
      <header class="page-head head">
        <h1 id="post-title">{title}</h1>

        <p class="meta">
          By <strong>{author}</strong> &middot;{' '}
          <time datetime={getPostDate(post).toISOString().slice(0, 10)}>
            {formatPostDate(getPostDate(post))}
          </time>
        </p>
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>

    <nav class="more" aria-label="More posts">
      {newer && (
        <a class="newer" href={getPostURL(newer)}>
          <small>
            <Icon name="arrowLeft" small />
            Next post
          </small>
          {newer.data.title}
        </a>
      )}

      {older && (
        <a class="older" href={getPostURL(older)}>
          <small>
            Previous post
            <Icon name="arrowRight" small />
          </small>
          {older.data.title}
        </a>
      )}
    </nav>
  </div>
</Site>

<style>
  .crumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 6px;
    padding-top: 22px;
    font-size: 15px;
    color: var(--muted);
  }

  .crumb {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 10px;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: var(--bg);
    color: var(--fg-strong);
    font-weight: 600;
  }

  .crumb:hover {
    border-color: var(--accent-line);
    background: var(--accent-soft);
    color: var(--accent-hover);
    text-decoration: none;
  }

  .separator {
    display: inline-flex;
    color: var(--faint);
  }

  .separator :global(.icon) {
    width: 11px;
    height: 11px;
  }

  .crumbs [aria-current='page'] {
    color: var(--fg-strong);
    font-weight: 600;
  }

  .head {
    padding-top: 14px;
  }

  .meta {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 16px;
  }

  .meta strong {
    color: var(--fg);
    font-weight: 600;
  }

  .more {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 40px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .more a {
    display: block;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--fg-strong);
    font-weight: 600;
  }

  .more a:hover {
    border-color: var(--accent-line);
    background: var(--accent-soft);
    text-decoration: none;
  }

  .older {
    grid-column: 2;
    text-align: right;
  }

  .older small {
    justify-content: flex-end;
  }

  .more small {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 2px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 400;
  }
</style>
