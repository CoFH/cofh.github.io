---
import Blog from '../layouts/Blog.astro';
import { getPosts, type Post, getPostDate, getPostURL } from '../lib/posts.ts';

const years = Map.groupBy(await getPosts(), (post) => getPostDate(post).getUTCFullYear());

const formatDate = (post: Post) => {
  const date = getPostDate(post);

  return `${String(date.getUTCDate()).padStart(2, '0')} ${date.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' })}`;
};
---

<Blog title="Archive" showBanner={false}>
  <h1>Archive</h1>
  <hr />

  {[...years].map(([year, posts]) => (
    <>
      <h3>{year}</h3>

      <ul>
        {posts.map((post) => (
          <li>
            {formatDate(post)} - <a href={getPostURL(post)}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </>
  ))}
</Blog>
