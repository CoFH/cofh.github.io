---
import { Image } from 'astro:assets';

import Base from '../layouts/Base.astro';
import { image } from '../lib/images.ts';
---

<Base title="Page not found" showBanner={false}>
  <div
    class="uk-width-1-1 uk-width-medium-3-4 uk-container-center uk-text-center"
    style="margin-top: 20px; margin-bottom: 40px"
  >
    <Image src={image('thermal-expansion-4/debugger.png')} alt="" loading="eager" />

    <h1>Page not found</h1>

    <p>
      There is no page at this address. Try the search above, or start from the{' '}
      <a href="/docs/">documentation</a> or the <a href="/downloads/">downloads</a>.
    </p>
  </div>
</Base>
