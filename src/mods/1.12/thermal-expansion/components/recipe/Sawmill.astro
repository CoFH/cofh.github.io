---
import type { Recipe } from '../../../../types.ts';
import Chance from '../../../../../components/docs/recipe/Chance.astro';
import { asSlot } from '../../../../../components/docs/recipe/narrow.ts';
import RecipeFrame from '../../../../../components/docs/recipe/RecipeFrame.astro';
import Slot from '../../../../../components/docs/recipe/Slot.astro';
import background from './sawmill.png';

interface Props {
  recipe: Recipe;
}

const { recipe } = Astro.props;
---

<RecipeFrame background={background}>
  <Slot data={asSlot(recipe.inputs[0])} top={16} left={10} />
  <Slot data={asSlot(recipe.outputs[0])} top={18} left={114} />
  <Slot data={asSlot(recipe.outputs[1])} top={70} left={114} />
  <Chance value={asSlot(recipe.outputs[1])?.chance} top={80} right={56} align="right" />
</RecipeFrame>
