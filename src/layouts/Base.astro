---
import '../styles/global.css';

import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

import jquery from 'jquery/dist/jquery.min.js?url';
import uikitAccordionCss from 'uikit/dist/css/components/accordion.min.css?url';
import uikitTooltipCss from 'uikit/dist/css/components/tooltip.min.css?url';
import uikitCss from 'uikit/dist/css/uikit.min.css?url';
import uikitAccordion from 'uikit/dist/js/components/accordion.min.js?url';
import uikitTooltip from 'uikit/dist/js/components/tooltip.min.js?url';
import uikit from 'uikit/dist/js/uikit.min.js?url';

import SearchBar from '../components/SearchBar.astro';
import logo from '../images/logo.png';
import logoShare from '../images/logo_share.png';
import { EXTERNAL_LINKS } from '../lib/external-links.ts';

interface Props {
  title: string | undefined;
  showBanner: boolean;
}

const fullTitle =
  Astro.props.title === undefined ? 'Team CoFH' : `${Astro.props.title} - Team CoFH`;

const description =
  'The official site for news, downloads and documentation for the Team CoFH Minecraft mods: Redstone Flux, CoFH Core, CoFH World, Thermal Series (Thermal Expansion, Thermal Foundation, Thermal Dynamics, Thermal Cultivation, Thermal Innovation), Redstone Arsenal, Vanilla+ Series (Tools, Satchels)';

const banners = import.meta.glob<ImageMetadata>('../images/banners/*.jpg', {
  eager: true,
  import: 'default',
});

const navbarLinks = [
  { title: 'About', url: '/about/' },
  { title: 'Documentation', url: '/docs/' },
  { title: 'Downloads', url: '/downloads/' },
];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />

    <title>{fullTitle}</title>

    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(logoShare.src, Astro.site)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:description" content={description} />

    <meta property="twitter:card" content="summary" />
    <meta property="twitter:site" content="@TeamCoFH" />

    <link href="/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link href="/favicon.ico" rel="icon" type="image/x-icon" />

    <link rel="stylesheet" href={uikitCss} />
    <link rel="stylesheet" href={uikitAccordionCss} />
    <link rel="stylesheet" href={uikitTooltipCss} />

    <script is:inline src={jquery}></script>
    <script is:inline src={uikit}></script>
    <script is:inline src={uikitAccordion}></script>
    <script is:inline src={uikitTooltip}></script>
  </head>

  <body>
    {Astro.props.showBanner && (
      <div
        class="cofh-banner uk-hidden-small"
        data-banners={JSON.stringify(Object.values(banners).map((banner) => banner.src))}
      >
        <div class="uk-container uk-container-center">
          <a href="/">
            <Image class="cofh-logo" src={logo} alt="Team CoFH" loading="eager" />
          </a>
        </div>
      </div>
    )}

    <nav class="uk-navbar uk-margin-bottom">
      <div class="uk-container uk-container-center">
        <a
          href="/"
          class:list={[
            'uk-navbar-brand',
            'uk-hidden-small',
            { 'uk-active': Astro.url.pathname === '/' },
          ]}
        >
          Team CoFH
        </a>

        <a
          href="#cofh-offcanvas"
          class="uk-navbar-toggle uk-visible-small"
          aria-label="Menu"
          data-uk-offcanvas
        ></a>

        <a
          href="/"
          class:list={[
            'uk-navbar-brand',
            'uk-navbar-center',
            'uk-visible-small',
            { 'uk-active': Astro.url.pathname === '/' },
          ]}
        >
          Team CoFH
        </a>

        <ul class="uk-navbar-nav uk-hidden-small">
          {navbarLinks.map((link) => (
            <li class:list={{ 'uk-active': Astro.url.pathname.startsWith(link.url) }}>
              <a href={link.url}>{link.title}</a>
            </li>
          ))}
        </ul>

        <SearchBar class="uk-navbar-content uk-navbar-flip uk-hidden-small" instance="navbar" />
      </div>
    </nav>

    <div id="cofh-offcanvas" class="uk-offcanvas">
      <div class="uk-offcanvas-bar">
        <SearchBar class="uk-panel" instance="offcanvas" hideShortcut />

        <ul class="uk-nav uk-nav-offcanvas">
          <li class:list={{ 'uk-active': Astro.url.pathname === '/' }}>
            <a href="/">Home</a>
          </li>
          {navbarLinks.map((link) => (
            <li class:list={{ 'uk-active': Astro.url.pathname.startsWith(link.url) }}>
              <a href={link.url}>{link.title}</a>
            </li>
          ))}
          <li class:list={{ 'uk-active': Astro.url.pathname.startsWith('/archive/') }}>
            <a href="/archive/">Archive</a>
          </li>
          <li class="uk-nav-divider"></li>
          {EXTERNAL_LINKS.map((link) => (
            <li>
              <a href={link.url}>{link.title}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="uk-container uk-container-center">
      <slot />

      <div class="uk-clearfix uk-margin-top uk-margin-bottom uk-text-small">
        <hr />

        <div class="uk-float-left">
          &copy; Copyright 2015-{new Date().getUTCFullYear()} Team CoFH. Powered by{' '}
          <a href="https://pages.github.com">GitHub Pages</a>,{' '}
          <a href="https://astro.build">Astro</a>, <a href="http://getuikit.com">UIkit</a>.<br />
          Last updated:{' '}
          {new Date()
            .toISOString()
            .replace('T', ' ')
            .replace(/\.\d+Z$/, ' +0000')}
        </div>

        <div class="uk-float-right">
          <ul class="uk-subnav uk-subnav-line">
            <li>
              <a href="/sitemap-index.xml">Sitemap</a>
            </li>
            <li>
              <a href="/feed.xml">Feed</a>
            </li>
            <li>
              <a href="#top" data-uk-smooth-scroll>
                Back to top
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <template id="cofh-heading-links">
      <a class="uk-margin-small-left cofh-clickable-icon" title="Permalink" aria-label="Permalink">
        <i class="uk-icon-link"></i>
      </a>
      <a
        href="#top"
        class="uk-float-right uk-margin-right cofh-clickable-icon"
        title="Back to top"
        aria-label="Back to top"
        data-uk-smooth-scroll
      >
        <i class="uk-icon-chevron-up"></i>
      </a>
    </template>

    <script>
      const banner = document.querySelector<HTMLElement>('.cofh-banner');

      if (banner !== null) {
        const banners: string[] = JSON.parse(banner.dataset.banners ?? '[]');
        banner.style.backgroundImage = `url(${banners[Math.floor(Math.random() * banners.length)]})`;
      }

      const headingLinks = document.getElementById('cofh-heading-links') as HTMLTemplateElement;

      for (const heading of document.querySelectorAll(':is(h1, h2, h3, h4, h5, h6)[id]')) {
        const links = headingLinks.content.cloneNode(true) as DocumentFragment;

        links.firstElementChild?.setAttribute('href', `#${heading.id}`);
        heading.append(links);
      }
    </script>
  </body>
</html>

<style>
  .cofh-banner {
    width: 100%;
    height: 185px;
    background-color: #222222;
    background-repeat: no-repeat;
    background-position: center center;
    background-size: cover;
  }

  .cofh-logo {
    position: relative;
    top: 20px;
    width: auto;
    height: 145px;
  }

  .uk-navbar-brand:not(.uk-navbar-center) {
    padding-left: 0;
  }

  .uk-navbar-brand.uk-active,
  .uk-navbar .uk-navbar-nav > li.uk-active > a {
    color: #0064f1;
  }

  .uk-navbar-brand:hover,
  .uk-navbar-brand.uk-active:hover,
  .uk-navbar .uk-navbar-nav > li > a:hover {
    color: #2d7eef;
  }

  .uk-nav-offcanvas > li > a {
    padding: 6px 15px;
  }
</style>
