---
import type { MarkdownHeading } from 'astro';

import Icon from './Icon.astro';

interface Props {
  headings: MarkdownHeading[];
  inline?: boolean;
}

const { headings, inline } = Astro.props;

const entries: { id: string; text: string; number: string; sub: boolean }[] = [];

let section = 0;
let subsection = 0;

for (const { depth, slug, text } of headings) {
  if (depth === 2) {
    section += 1;
    subsection = 0;

    entries.push({
      id: slug,
      text,
      number: String(section),
      sub: false,
    });
  } else if (depth === 3) {
    subsection += 1;

    entries.push({
      id: slug,
      text,
      number: `${section}.${subsection}`,
      sub: true,
    });
  }
}
---

{inline ? (
  <details class="inline" data-pagefind-ignore>
    <summary>
      <Icon name="list" />
      On this page
      <span class="chevron">
        <Icon name="chevron" />
      </span>
    </summary>

    <nav class="toc" aria-label="On this page">
      <ol>
        {entries.map((entry) => (
          <li class:list={{ sub: entry.sub }}>
            <a href={`#${entry.id}`} data-id={entry.id}>
              <span class="number">{entry.number}</span>
              <span>{entry.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </details>
) : (
  <aside class="side" data-pagefind-ignore>
    <nav class="toc" aria-label="On this page (sidebar)">
      <p class="title">
        <Icon name="list" small />
        On this page
      </p>

      <ol>
        {entries.map((entry) => (
          <li class:list={{ sub: entry.sub }}>
            <a href={`#${entry.id}`} data-id={entry.id}>
              <span class="number">{entry.number}</span>
              <span>{entry.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </aside>
)}

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a[data-id]')];

  const headings = [...new Set(links.map((link) => link.dataset.id))]
    .map((id) => (id === undefined ? null : document.getElementById(id)))
    .filter((heading) => heading !== null);

  let current: string | null = null;

  function setCurrent({ id }: HTMLElement) {
    if (id === current) {
      return;
    }

    current = id;

    for (const link of links) {
      if (link.dataset.id === id) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    }
  }

  // Mark the last heading in the top 30% of the window as the one being read, or the last one
  // once the page is scrolled to the end
  function update() {
    const atEnd = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 1;
    const line = window.innerHeight * 0.3;
    const above = headings.filter((heading) => heading.getBoundingClientRect().top < line);

    setCurrent((atEnd ? headings.at(-1) : above.at(-1)) ?? headings[0]);
  }

  update();
  document.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
</script>

<style>
  .side {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    margin-top: 40px;
    max-height: calc(100vh - var(--nav-h) - 48px);
    overflow: auto;
    scrollbar-width: thin;
  }

  .title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    display: flex;
    gap: 8px;
    padding: 4px 10px 4px 12px;
    border-left: 2px solid var(--line);
    color: var(--muted);
    font-size: 15px;
    line-height: 1.35;
  }

  a:hover {
    color: var(--fg-strong);
    text-decoration: none;
    border-left-color: var(--line-strong);
  }

  a[aria-current] {
    color: var(--accent);
    border-left-color: var(--accent);
    font-weight: 600;
  }

  .sub a {
    padding-left: 22px;
    font-size: 14px;
  }

  .number {
    flex: none;
    min-width: 1.6em;
    padding-top: 0.12em;
    font: 400 12.5px/1.35 var(--mono);
    font-variant-numeric: tabular-nums;
    color: var(--faint);
  }

  .sub .number {
    min-width: 2.2em;
  }

  a[aria-current] .number {
    color: var(--accent);
  }

  .inline {
    display: none;
    margin: -8px 0 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  summary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .chevron {
    display: inline-flex;
    margin-left: auto;
    color: var(--muted);
    transition: transform 0.15s;
  }

  .inline[open] .chevron {
    transform: rotate(180deg);
  }

  .inline .toc {
    padding: 0 14px 12px;
  }

  .inline a {
    border-left-color: var(--line-strong);
  }

  @media (max-width: 1099px) {
    .side {
      display: none;
    }

    .inline {
      display: block;
    }
  }
</style>
