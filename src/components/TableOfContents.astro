---
import type { MarkdownHeading } from 'astro';

import Icon from './Icon.astro';

interface Props {
  headings: MarkdownHeading[];
  appendix?: { slug: string; text: string }[];
  mobile?: boolean;
}

const { headings, appendix = [], mobile } = Astro.props;

interface TocEntry {
  id: string;
  text: string;
  number: string | undefined;
  sub: boolean;
}

let section = 0;
let subsection = 0;

const entries = headings.flatMap(({ depth, slug, text }): TocEntry[] => {
  if (depth === 2) {
    section += 1;
    subsection = 0;

    return [{ id: slug, text, number: String(section), sub: false }];
  }

  if (depth === 3) {
    subsection += 1;

    return [{ id: slug, text, number: `${section}.${subsection}`, sub: true }];
  }

  return [];
});

if (entries.length > 0) {
  entries.push(
    ...appendix.map(({ slug, text }) => ({ id: slug, text, number: undefined, sub: false })),
  );
}
---

{entries.length > 0 &&
  (mobile ? (
    <div class="mobile-bar" data-pagefind-ignore>
      <details class="mobile panel panel-muted">
        <summary>
          <Icon name="list" />
          On this page
          <span class="chevron">
            <Icon name="chevronDown" />
          </span>
        </summary>

        <nav class="toc" aria-label="On this page">
          <ol>
            {entries.map((entry) => (
              <li class:list={{ sub: entry.sub, appendix: entry.number === undefined }}>
                <a href={`#${entry.id}`} data-id={entry.id}>
                  <span class="number">{entry.number}</span>
                  <span>{entry.text}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    </div>
  ) : (
    <aside class="side" data-pagefind-ignore>
      <nav class="toc" aria-label="On this page (sidebar)">
        <p class="title small-label">
          <Icon name="list" small />
          On this page
        </p>

        <ol>
          {entries.map((entry) => (
            <li class:list={{ sub: entry.sub, appendix: entry.number === undefined }}>
              <a href={`#${entry.id}`} data-id={entry.id}>
                <span class="number">{entry.number}</span>
                <span>{entry.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>
  ))}

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a[data-id]')];

  const headings = [...new Set(links.map((link) => link.dataset.id))]
    .map((id) => (id !== undefined ? document.getElementById(id) : null))
    .filter((heading) => heading !== null);

  let current: string | null = null;

  function setCurrent({ id }: HTMLElement) {
    if (id === current) {
      return;
    }

    current = id;

    links.forEach((link) => {
      if (link.dataset.id === id) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  let pinned: HTMLElement | null = null;

  // Highlight the last heading that has scrolled up to just below the site header (where clicking
  // its link puts it), or the page's last heading once the page can't scroll any further
  function update() {
    if (headings.length === 0) {
      return;
    }

    if (pinned !== null) {
      setCurrent(pinned);
      return;
    }

    const atEnd = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 1;
    const line = parseFloat(getComputedStyle(headings[0]).scrollMarginTop) + 1;
    const above = headings.filter((heading) => heading.getBoundingClientRect().top <= line);

    setCurrent((atEnd ? headings.at(-1) : above.at(-1)) ?? headings[0]);
  }

  // Keep a heading that was just linked to marked until the reader scrolls
  function pin() {
    pinned = headings.find((heading) => `#${heading.id}` === window.location.hash) ?? null;
    update();
  }

  function unpin() {
    pinned = null;
  }

  pin();
  window.addEventListener('hashchange', pin);
  links.forEach((link) => link.addEventListener('click', () => requestAnimationFrame(pin)));

  ['wheel', 'touchmove', 'keydown', 'pointerdown'].forEach((type) =>
    window.addEventListener(type, unpin, { passive: true }),
  );

  document.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);

  const mobileBar = document.querySelector<HTMLElement>('.mobile-bar');
  const mobileDropdown = document.querySelector<HTMLDetailsElement>('.mobile-bar details');

  if (mobileBar !== null && mobileDropdown !== null) {
    new ResizeObserver(() => {
      document.documentElement.style.setProperty('--mobile-toc-h', `${mobileBar.offsetHeight}px`);
    }).observe(mobileBar);

    mobileDropdown.addEventListener('toggle', () => {
      const toc = mobileDropdown.querySelector<HTMLElement>('.toc')!;
      const link = toc.querySelector<HTMLElement>('a[aria-current]');

      if (mobileDropdown.open && link !== null) {
        toc.scrollTop = link.offsetTop - (toc.clientHeight - link.offsetHeight) / 2;
      }
    });

    mobileDropdown
      .querySelectorAll('a')
      .forEach((link) => link.addEventListener('click', () => (mobileDropdown.open = false)));
  }
</script>

<style>
  .side {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    margin-top: 40px;
    max-height: calc(100vh - var(--nav-h) - 48px);
    overflow: auto;
    scrollbar-width: thin;
  }

  .title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--line);
  }

  a {
    display: flex;
    gap: 8px;
    margin-left: -2px;
    padding: 4px 10px 4px 12px;
    border-left: 2px solid transparent;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.35;
  }

  a:hover {
    color: var(--fg-strong);
    text-decoration: none;
    border-left-color: var(--line-strong);
  }

  a[aria-current] {
    color: var(--accent);
    border-left-color: var(--accent);
    font-weight: 600;
  }

  li:not(.appendix) + .appendix {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid var(--line);
  }

  .sub a {
    padding-left: 22px;
    font-size: 14px;
  }

  .number {
    flex: none;
    min-width: 1.6em;
    padding-top: 0.12em;
    font: 400 12.5px/1.35 var(--mono);
    font-variant-numeric: tabular-nums;
    color: var(--faint);
  }

  .sub .number {
    min-width: 2.2em;
  }

  a[aria-current] .number {
    color: var(--accent);
  }

  .mobile-bar {
    display: none;
    position: sticky;
    top: var(--nav-h);
    z-index: 20;
    margin: -12px 0 20px;
    padding: 4px 0;
    background: var(--bg);
  }

  .mobile {
    position: relative;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .chevron {
    display: inline-flex;
    margin-left: auto;
    color: var(--muted);
  }

  .mobile[open] .chevron {
    transform: rotate(180deg);
  }

  .mobile .toc {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    max-height: 60vh;
    overflow: auto;
    overscroll-behavior: contain;
    padding: 10px 14px 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--bg);
    box-shadow:
      0 10px 30px var(--shadow-strong),
      0 1px 3px var(--shadow);
    scrollbar-width: thin;
  }

  .mobile ol {
    border-left-color: var(--line-strong);
  }

  @media (max-width: 1099px) {
    .side {
      display: none;
    }

    .mobile-bar {
      display: block;
    }
  }
</style>
