---
import type { ModListMod } from '../../mods/types.ts';
import Icon from '../Icon.astro';

interface Props {
  mod: ModListMod;
}

const { mod } = Astro.props;
---

{mod.links.curseforge !== undefined && (
  <a
    class="btn btn-sm"
    href={mod.links.curseforge}
    aria-label={`Download ${mod.title} on CurseForge`}
  >
    <Icon name="curseforge" />
    <span>CurseForge</span>
  </a>
)}

{mod.links.modrinth !== undefined && (
  <a class="btn btn-sm" href={mod.links.modrinth} aria-label={`Download ${mod.title} on Modrinth`}>
    <Icon name="modrinth" />
    <span>Modrinth</span>
  </a>
)}
