---
import Site from '../../layouts/Site.astro';
import { currentVersion, getModsHref } from '../../lib/mods.ts';
import modList from '../../mods/mod-list.ts';
import type { ModListVersion } from '../../mods/types.ts';
import Icon from '../Icon.astro';
import ModCard from './ModCard.astro';
import ModSectionHead from './ModSectionHead.astro';

interface Props {
  version: ModListVersion;
}

const { version } = Astro.props;
---

<Site title="Mods">
  <div
    class="wrap"
    data-pagefind-body
    data-pagefind-meta="version[data-version]"
    data-version={version.label}
  >
    <header class="page-head">
      <h1>Mods</h1>

      <ul class="notes">
        <li>
          <Icon name="hammer" />
          <span>
            Mods for Minecraft 1.20 and below run on{' '}
            <a href="https://files.minecraftforge.net/">Forge</a>. Minecraft 1.21 and above will use{' '}
            <a href="https://neoforged.net/">NeoForge</a> instead.
          </span>
        </li>
        <li>
          <Icon name="shield" />
          <span>
            Official downloads are <strong>only on CurseForge and Modrinth</strong>. Copies from
            other sites are not supported: use them at your own risk.
          </span>
        </li>
      </ul>
    </header>

    <div class="versions" id="versions">
      <span class="eyebrow small-label" aria-hidden="true">
        Minecraft
      </span>

      <nav class="tabs" aria-label="Minecraft version">
        {modList.map((versionItem) => (
          <a
            class:list={['tab', { minor: !versionItem.major }]}
            href={`${getModsHref(versionItem)}#versions`}
            aria-current={versionItem.mc === version.mc ? 'page' : undefined}
          >
            {versionItem.label}

            {versionItem === currentVersion && (
              <span class="featured" data-tooltip="Active development">
                <Icon name="star" small />
              </span>
            )}
          </a>
        ))}
      </nav>
    </div>

    <div class="tab-content">
      {version.mc !== currentVersion.mc && (
        <div class="outdated">
          <Icon name="warning" />
          <p>
            Minecraft {version.label} is outdated and no longer supported. Expect no new content or
            bug fixes.
          </p>
        </div>
      )}

      {version.sections.map((section) => (
        <section class="section">
          <ModSectionHead section={section} level={2} />

          <div class="grid">
            {section.mods.map((mod) => (
              <ModCard version={version} mod={mod} />
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</Site>

<script>
  const tabs = document.querySelector<HTMLElement>('.tabs')!;
  const current = tabs.querySelector<HTMLElement>('[aria-current="page"]')!;

  const offset = current.getBoundingClientRect().left - tabs.getBoundingClientRect().left;

  tabs.scrollLeft += offset - (tabs.clientWidth - current.offsetWidth) / 2;
</script>

<style>
  .page-head {
    padding-bottom: 0;
    border-bottom: 0;
    margin-bottom: 0;
  }

  .tabs {
    display: flex;
    gap: 2px;
    border-bottom: 1px solid var(--line-strong);
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .versions {
    position: sticky;
    top: var(--nav-h);
    scroll-margin-top: var(--nav-h);
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 14px;
    border-bottom: 1px solid var(--line-strong);
    background: var(--bg);
  }

  .versions .tabs {
    border-bottom: 0;
    flex: 1;
    min-width: 0;
    margin-bottom: -1px;
    padding-bottom: 1px;
  }

  .tab {
    position: relative;
    border: 0;
    background: none;
    padding: 9px 16px 10px;
    font-size: 15px;
    font-weight: 600;
    color: var(--fg);
    cursor: pointer;
    white-space: nowrap;
    border-radius: var(--radius) var(--radius) 0 0;
    font-variant-numeric: tabular-nums;
  }

  .tab.minor {
    color: var(--faint);
  }

  .tab:hover {
    color: var(--fg-strong);
    background: var(--surface);
    text-decoration: none;
  }

  .tab[aria-current='page'] {
    color: var(--accent);
    background: var(--surface);
  }

  .tab[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: -1px;
    height: 3px;
    border-radius: 3px 3px 0 0;
    background: var(--accent);
  }

  .tab:focus-visible {
    outline-offset: -3px;
  }

  .notes {
    list-style: none;
    margin: 16px 0 20px;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .notes li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 15px;
    line-height: 1.45;
  }

  .notes :global(.icon) {
    flex: none;
    width: 16px;
    color: var(--muted);
    margin-top: 3px;
  }

  .featured {
    margin-left: 6px;
  }

  .eyebrow {
    flex: none;
  }

  .tab-content {
    padding-top: 14px;
  }

  .outdated {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-bottom: 24px;
    padding: 12px 16px;
    border: 1px solid var(--warn-line);
    border-radius: var(--radius-lg);
    background: var(--warn-bg);
    color: var(--fg);
    font-size: 15px;
  }

  .outdated > :global(.icon) {
    margin-top: 3px;
    color: var(--warn-icon);
  }

  .outdated p {
    margin: 0;
  }

  .section {
    display: grid;
    gap: 14px;
  }

  .section + .section {
    margin-top: 32px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }
</style>
