---
import type { ModListSection } from '../../mods/types.ts';

interface Props {
  section: ModListSection;
  level: 2 | 3;
}

const { section, level } = Astro.props;

const Heading = level === 2 ? 'h2' : 'h3';
---

<div class="head">
  <Heading>{section.title}</Heading>
</div>

<style>
  .head {
    background: var(--band);
    padding: 8px 14px;
    border-radius: var(--radius);
  }

  .head :is(h2, h3) {
    margin: 0;
    font-size: 19px;
  }
</style>
