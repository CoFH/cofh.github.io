---
import type { ModListMod } from '../../mods/types.ts';
import Icon from '../Icon.astro';
import DownloadButtons from './DownloadButtons.astro';

interface Props {
  mod: ModListMod;
  requires: { title: string; href: string }[];
}

const { mod, requires } = Astro.props;
---

{requires.length > 0 && (
  <p class="requires">
    Requires{' '}
    {requires.map((required, index) => (
      <>
        {index > 0 && ', '}
        <a href={required.href}>{required.title}</a>
      </>
    ))}
  </p>
)}

<div class="buttons" data-pagefind-ignore="all">
  <DownloadButtons mod={mod} />
</div>

{Astro.slots.has('default') && (
  <div class="buttons" data-pagefind-ignore="all">
    <slot />
  </div>
)}

<div class="links" data-pagefind-ignore="all">
  {mod.links.source !== undefined && (
    <a href={mod.links.source}>
      <Icon name="code" small />
      Source
    </a>
  )}

  {mod.links.changelog !== undefined && (
    <a href={mod.links.changelog}>
      <Icon name="file" small />
      Changelog
    </a>
  )}
</div>

<style>
  .requires {
    margin: auto 0 0;
    padding-top: 10px;
    font-size: 13px;
    color: var(--muted);
  }

  .requires + .buttons {
    margin-top: 0;
    padding-top: 8px;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 14px;
  }

  .buttons > :global(*) {
    flex: 1 1 auto;
  }

  .buttons + .buttons {
    margin-top: 8px;
    padding-top: 0;
  }

  .buttons:empty {
    display: none;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    min-height: 1lh;
    margin-top: 10px;
    font-size: 14px;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--muted);
  }

  .links a:hover {
    color: var(--accent);
  }
</style>
