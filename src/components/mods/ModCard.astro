---
import { Image } from 'astro:assets';

import { getModLogo } from '../../lib/mods.ts';
import type { ModListMod, ModListVersion } from '../../mods/types.ts';
import DocsButton from './DocsButton.astro';
import ModDownload from './ModDownload.astro';

interface Props {
  version: ModListVersion;
  mod: ModListMod;
}

const { version, mod } = Astro.props;

const logo = getModLogo(version, mod.slug);

const titles = new Map(
  version.sections.flatMap((section) => section.mods).map((item) => [item.slug, item.title]),
);

const requires = (mod.requires ?? []).map((slug) => ({
  title: titles.get(slug) ?? slug,
  href: `#${slug}`,
}));
---

<article class="card panel" id={mod.slug} aria-labelledby={`${mod.slug}-title`}>
  <div class="logo">
    {logo !== undefined && (
      <Image
        src={logo}
        alt={`${mod.title} logo`}
        height={64}
        densities={[1, 2]}
        data-pagefind-ignore="all"
      />
    )}
  </div>

  <div class="body">
    <h3 id={`${mod.slug}-title`}>{mod.title}</h3>

    <p class="summary">{mod.summary}</p>

    <ModDownload mod={mod} requires={requires}>
      <DocsButton version={version} mod={mod} />
    </ModDownload>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    scroll-margin-top: calc(var(--nav-h) + 104px);
  }

  .card:target {
    animation: target-ring 1.6s ease;
  }

  .logo {
    height: 92px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 20px;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }

  .logo img {
    max-height: 64px;
    max-width: 100%;
    object-fit: contain;
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 14px 16px 14px;
  }

  .body h3 {
    margin: 0;
    font-size: 17px;
  }

  .summary {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.45;
  }
</style>
