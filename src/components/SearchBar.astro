---
import { getIconDataUri, icons } from '../lib/icons.ts';
import type { ModListVersion } from '../mods/types.ts';
import Icon from './Icon.astro';

interface Props {
  version: ModListVersion | undefined;
}

const { version } = Astro.props;

const separator = `<svg class="result-separator" viewBox="${icons.chevronRight.viewBox}" aria-hidden="true"><path d="${icons.chevronRight.path}" fill="currentColor" /></svg>`;

const resultTemplate = `
<li class="pf-result">
  <div class="pf-result-card">
    {{#if and(options.show_images, meta.image)}}
    <img class="pf-result-image" src="{{ meta.image | resolveUrl(meta.url | default(url)) }}" alt="{{ meta.image_alt | default(meta.title) }}">
    {{/if}}
    <div class="pf-result-content">
      <p class="pf-result-title">
        <a class="pf-result-link" href="{{ meta.url | default(url) | safeUrl }}">{{ meta.title }}</a>
      </p>
      {{#if meta.version}}
      <p class="result-badge">Minecraft {{ meta.version }}{{#if meta.mod}} ${separator} {{ meta.mod }}{{/if}}</p>
      {{/if}}
      {{#if excerpt}}
      <p class="pf-result-excerpt">{{+ excerpt +}}</p>
      {{/if}}
    </div>
  </div>
  {{#if sub_results}}
  <ul class="pf-heading-chips">
    {{#each sub_results as sub}}
    <li class="pf-heading-chip">
      <a class="pf-heading-link" href="{{ sub.url | safeUrl }}">{{ sub.title }}</a>
      <p class="pf-heading-excerpt">{{+ sub.excerpt +}}</p>
    </li>
    {{/each}}
  </ul>
  {{/if}}
</li>`;
---

<div
  class="search"
  style={`--pf-icon-search: ${getIconDataUri('search')}`}
  data-version={version?.mc}
>
  <pagefind-modal-trigger instance="site" placeholder="Search" />

  <pagefind-modal instance="site">
    <pagefind-modal-header>
      <pagefind-input instance="site" />
    </pagefind-modal-header>

    <pagefind-modal-body>
      {version !== undefined && (
        <div class="scope">
          <button
            type="button"
            class="scope-chip"
            aria-label={`Search all versions instead of only Minecraft ${version.label}`}
          >
            Minecraft {version.label}
            <Icon name="close" small />
          </button>

          <p class="other-versions" hidden>
            <span class="other-count"></span> more in other versions ·{' '}
            <button type="button" class="all-versions">
              Search all versions
            </button>
          </p>
        </div>
      )}

      <pagefind-summary instance="site" />

      <pagefind-results instance="site" show-images>
        <script is:inline type="text/pagefind-template" set:html={resultTemplate} />
      </pagefind-results>
    </pagefind-modal-body>

    <pagefind-modal-footer>
      <pagefind-keyboard-hints instance="site" />
    </pagefind-modal-footer>
  </pagefind-modal>
</div>

<script>
  import '@pagefind/component-ui';
  import '@pagefind/component-ui/css/pagefind-component-ui.css';

  import { getInstanceManager } from '@pagefind/component-ui';

  const search = document.querySelector<HTMLElement>('.search')!;
  const instance = getInstanceManager().getInstance('site');
  const version = search.dataset.version;

  if (version !== undefined) {
    const scope = search.querySelector<HTMLElement>('.scope')!;
    const otherVersions = search.querySelector<HTMLElement>('.other-versions')!;

    instance.searchFilters = { version: [version] };

    const searchAllVersions = () => {
      scope.hidden = true;
      instance.triggerFilter('version', []);
      search.querySelector('input')?.focus();
    };

    scope.querySelectorAll('button').forEach((button) => {
      button.addEventListener('click', searchAllVersions);
    });

    instance.on('filters', () => {
      const otherCount = Object.entries(instance.totalFilters!.version)
        .filter(([other]) => other !== version)
        .reduce((sum, [, count]) => sum + count, 0);

      otherVersions.hidden = instance.searchTerm === '' || otherCount === 0;
      otherVersions.querySelector('.other-count')!.textContent = String(otherCount);
    });
  }

  const iconOnly = window.matchMedia('(max-width: 760px)');

  // Give the search box a tooltip only while it shows just its icon
  function updateSearchTooltip() {
    if (iconOnly.matches) {
      search.dataset.tooltip = 'Search';
    } else {
      delete search.dataset.tooltip;
    }
  }

  updateSearchTooltip();
  iconOnly.addEventListener('change', updateSearchTooltip);
</script>

<style>
  .search {
    --pf-font: var(--font);
    --pf-text: var(--fg);
    --pf-text-secondary: var(--muted);
    --pf-text-muted: var(--faint);
    --pf-background: var(--bg);
    --pf-border: var(--line-strong);
    --pf-border-focus: var(--accent-line);
    --pf-hover: var(--accent-soft);
    --pf-mark: var(--fg-strong);
    --pf-skeleton: var(--surface-2);
    --pf-skeleton-shine: var(--surface);
    --pf-scroll-shadow: var(--shadow);
    --pf-shadow-sm: none;
    --pf-shadow-md: 0 4px 12px var(--shadow);
    --pf-shadow-lg: 0 24px 60px var(--shadow-strong);
    --pf-outline-focus: var(--focus);
    --pf-modal-backdrop: var(--scrim);
    --pf-modal-max-width: 640px;
    --pf-input-height: 32px;
    --pf-border-radius: var(--radius);
    width: 240px;
  }

  .search :global(.pf-trigger-btn) {
    padding: 0 6px 0 10px !important;
    font: 15px var(--font) !important;
  }

  .search :global(.pf-trigger-icon) {
    width: 16px !important;
    height: 16px !important;
  }

  .search :global(.pf-trigger-key) {
    padding: 2px 5px !important;
    border-color: var(--line-strong) !important;
    border-bottom-width: 2px !important;
    background: var(--surface) !important;
    color: var(--muted) !important;
    font: 600 11px/1 var(--font) !important;
  }

  :global([data-pagefind-announcer]) {
    position: fixed;
    top: 0;
    left: 0;
  }

  .search pagefind-modal-trigger:hover {
    --pf-text-muted: var(--muted);
  }

  .search pagefind-modal-trigger {
    display: block;
    width: 100%;
  }

  .search pagefind-modal:not(:defined) {
    display: none;
  }

  .scope {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin-bottom: 8px;
  }

  .scope[hidden] {
    display: none;
  }

  .scope-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--fg);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
  }

  .scope-chip:hover {
    border-color: var(--accent-line);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .other-versions {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
  }

  .all-versions {
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .all-versions:hover {
    text-decoration: underline;
  }

  .search :global(.result-badge) {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 12.5px;
    font-weight: 600;
  }

  .search :global(.result-separator) {
    width: 11px;
    height: 11px;
    color: var(--faint);
  }

  .search :global(.pf-result-image) {
    width: 48px !important;
    height: 48px !important;
    background: none !important;
    object-fit: contain !important;
    image-rendering: pixelated !important;
    align-self: center !important;
  }

  @media (max-width: 760px) {
    .search {
      width: 34px;
    }

    .search :global(.pf-trigger-btn) {
      justify-content: center !important;
      height: 34px !important;
      padding: 0 !important;
      border-color: transparent !important;
      background: transparent !important;
    }

    .search :global(.pf-trigger-btn:hover) {
      background: var(--band-hover) !important;
    }

    .search :global(.pf-trigger-icon) {
      background: var(--fg) !important;
    }

    .search :global(:is(.pf-trigger-text, .pf-trigger-shortcut)) {
      display: none !important;
    }
  }
</style>
