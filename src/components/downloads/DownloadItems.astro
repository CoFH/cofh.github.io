---
import { Image } from 'astro:assets';

import { getModDocs, getModListVersion, getModLogo } from '../../lib/mods.ts';

interface Props {
  minecraft: string;
}

const mc = Astro.props.minecraft;
const mods = getModListVersion(mc).sections.flatMap((section) => section.mods);

function getModAnchor(slug: string): string {
  return `${slug}-${mc.replace('.', '-')}`;
}

const entries = await Promise.all(
  mods.map(async (mod) => ({
    mod,
    logo: getModLogo(mc, mod.slug),
    docs: await getModDocs(mc, mod),
    requires: (mod.requires ?? []).map((slug) => ({
      id: getModAnchor(slug),
      title: mods.find((m) => m.slug === slug)?.title,
    })),
  })),
);
---

<div>
  {entries.map(({ mod, logo, docs, requires }, index) => (
    <div
      class:list={['uk-panel', 'uk-panel-box', { 'uk-margin-bottom': index < entries.length - 1 }]}
    >
      <div class="uk-grid" data-uk-grid-margin>
        <div class="uk-width-1-1 uk-width-medium-2-10">
          {logo !== undefined ? (
            <Image src={logo} alt={mod.title} class="cofh-download-logo" />
          ) : (
            <div class="cofh-download-logo cofh-download-logo-missing" />
          )}
        </div>

        <div class="uk-width-1-1 uk-width-medium-5-10">
          <h3 id={getModAnchor(mod.slug)}>{mod.title}</h3>
          <p>
            {mod.summary}
            {requires.length > 0 && (
              <>
                {' '}
                Requires{' '}
                {requires.map((required, i) => (
                  <>
                    {i > 0 && (i === requires.length - 1 ? ' and ' : ', ')}
                    <a href={`#${required.id}`}>{required.title}</a>
                  </>
                ))}
                .
              </>
            )}
          </p>
        </div>

        <div class="uk-width-1-1 uk-width-medium-3-10" data-uk-margin>
          {mod.links.curseforge !== undefined && (
            <a
              href={mod.links.curseforge}
              class="uk-button uk-button-small uk-button-success uk-text-bold uk-width-1-1"
            >
              Download on CurseForge
            </a>
          )}

          {mod.links.modrinth !== undefined && (
            <a
              href={mod.links.modrinth}
              class="uk-button uk-button-small uk-button-success uk-text-bold uk-width-1-1"
            >
              Download on Modrinth
            </a>
          )}

          {docs?.kind === 'link' && (
            <a href={docs.href} class="uk-button uk-button-small uk-width-1-1">
              Documentation
            </a>
          )}

          {mod.links.changelog !== undefined && (
            <a href={mod.links.changelog} class="uk-button uk-button-small uk-width-1-1">
              Changelog
            </a>
          )}

          {mod.links.source !== undefined && (
            <a href={mod.links.source} class="uk-button uk-button-small uk-width-1-1">
              Source code
            </a>
          )}
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  .cofh-download-logo {
    display: block;
    width: 100%;
    height: 80px;
    object-fit: contain;
  }

  .cofh-download-logo-missing {
    background-color: #dedede;
  }

  @media (min-width: 768px) {
    .cofh-download-logo {
      height: 115px;
    }
  }
</style>
