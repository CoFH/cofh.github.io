---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

const siteNames = {
  twitter: 'Twitter',
  github: 'GitHub',
  reddit: 'Reddit',
};

interface Props {
  name: string;
  avatar: ImageMetadata;
  description: string;
  links: { icon: keyof typeof siteNames; url: string }[];
}
---

<tr>
  <td style="width: 64px; min-width: 64px">
    <Image
      src={Astro.props.avatar}
      alt={Astro.props.name}
      width={64}
      height={64}
      densities={[1, 2]}
    />
  </td>

  <td class="cofh-nowrap">{Astro.props.name}</td>

  <td>{Astro.props.description}</td>

  <td class="uk-text-center cofh-nowrap" style="width: 1px">
    {Astro.props.links.map((link) => (
      <a
        class={`uk-icon-button uk-icon-${link.icon}`}
        href={link.url}
        aria-label={`${Astro.props.name} on ${siteNames[link.icon]}`}
      />
    ))}
  </td>
</tr>
