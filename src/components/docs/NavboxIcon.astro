---
import type { ImageMetadata } from 'astro';

import GameImage from './GameImage.astro';

interface Props {
  icon: ImageMetadata | undefined;
}

const { icon } = Astro.props;
---

{icon !== undefined && (
  <>
    <GameImage image={icon} height={16} alt="" class="navbox-icon" />{' '}
  </>
)}

<style>
  :global(.navbox-icon) {
    max-width: none;
    vertical-align: -3px;
  }
</style>
