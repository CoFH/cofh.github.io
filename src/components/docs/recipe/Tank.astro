---
import { getImage } from 'astro:assets';

import type { Fluid, RecipeTankData } from '../../../mods/types.ts';
import TankFluid from './TankFluid.astro';
import '../../../scripts/cycle.css';
import tankGaugeShort from './tank-gauge-short.png';
import tankGauge from './tank-gauge.png';

interface Props {
  data: RecipeTankData | undefined;
  top: number;
  left: number;
  short?: boolean;
  size: number;
}

const { data, top, left, short = false, size } = Astro.props;

const height = short ? 60 : 120;

const gaugeImage = await getImage({ src: short ? tankGaugeShort : tankGauge });

const amount = data !== undefined ? `${data.amount.toLocaleString('en-US')}\u00a0mB` : '';

const fill = data !== undefined && data.amount !== 0 ? Math.floor((data.amount * 100) / size) : 25;

let fluids: Fluid[] = [];

if (data !== undefined) {
  fluids = data.fluid !== undefined ? [data.fluid] : data.fluidGroup.fluids;
}
---

{data !== undefined && (
  <>
    <div
      style={{
        position: 'absolute',
        top: `${top}px`,
        left: `${left}px`,
        width: '32px',
        height: `${height}px`,
      }}
    >
      {fluids.length > 1 ? (
        <div class="cycle">
          {fluids.map((fluid, index) => (
            <div class:list={{ hidden: index > 0 }}>
              <TankFluid fluid={fluid} amount={amount} height={height} fill={fill} />
            </div>
          ))}
        </div>
      ) : (
        <TankFluid fluid={fluids[0]} amount={amount} height={height} fill={fill} />
      )}
    </div>

    <div
      style={{
        position: 'absolute',
        top: `${top}px`,
        left: `${left}px`,
        width: '32px',
        height: `${height}px`,
        background: `url('${gaugeImage.src}')`,
        pointerEvents: 'none',
      }}
    ></div>
  </>
)}

<script>
  import '../../../scripts/cycle.ts';
</script>
