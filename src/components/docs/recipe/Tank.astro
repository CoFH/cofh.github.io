---
import { getImage } from 'astro:assets';

import type { RecipeTankData } from '../../../mods/types.ts';
import tankGaugeShort from './tank-gauge-short.png';
import tankGauge from './tank-gauge.png';

interface Props {
  data: RecipeTankData | undefined;
  top: number;
  left: number;
  short?: boolean;
  size: number;
}

const { data, top, left, short = false, size } = Astro.props;

const height = short ? 60 : 120;

const gaugeImage = await getImage({ src: short ? tankGaugeShort : tankGauge });

const amount = data !== undefined ? `${data.amount.toLocaleString('en-US')}\u00a0mB` : '';

const fill = data === undefined || data.amount === 0 ? 25 : Math.floor((data.amount * 100) / size);
---

{data !== undefined && (
  <>
    <div
      style={{
        position: 'absolute',
        top: `${top}px`,
        left: `${left}px`,
        width: '32px',
        height: `${height}px`,
      }}
    >
      <a href={data.fluid.href} aria-label={`${data.fluid.name}, ${amount}`}>
        <div
          style={{
            position: 'relative',
            width: '32px',
            height: `${height}px`,
          }}
          title={`${data.fluid.name}<br />${amount}`}
          data-uk-tooltip="{pos: 'top', offset: 4}"
        >
          <div
            style={{
              position: 'absolute',
              bottom: '0',
              width: '32px',
              height: `${fill}%`,
              minHeight: '2px',
              backgroundImage: `url('${data.fluid.image.src}')`,
              backgroundSize: '32px',
              imageRendering: 'pixelated',
            }}
          ></div>
        </div>
      </a>
    </div>

    <div
      style={{
        position: 'absolute',
        top: `${top}px`,
        left: `${left}px`,
        width: '32px',
        height: `${height}px`,
        background: `url('${gaugeImage.src}')`,
        pointerEvents: 'none',
      }}
    ></div>
  </>
)}
