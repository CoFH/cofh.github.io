---
import { getImage } from 'astro:assets';

import fluids from '../../../data/recipe-fluids.ts';
import { getRecipeSiteUrl } from '../../../data/recipe-sites.ts';
import type { MachineRecipeElement, RecipeTankData } from '../../../data/types.ts';
import { image } from '../../../lib/images.ts';

interface Props {
  data: RecipeTankData;
  element: Extract<MachineRecipeElement, { tank: string }>;
  background: string;
}

const { data, element, background } = Astro.props;

const fluid = fluids[data.fluid];

const height = element.height ?? 120;

const amount = `${data.amount.toLocaleString('en-US')}\u00a0mB`;

const fill = data.amount === 0 ? 25 : Math.floor((data.amount * 100) / element.size);

const fluidSprite = await getImage({ src: image(`recipe/fluid-sprites/${data.fluid}.gif`) });
---

<div
  style={{
    position: 'absolute',
    top: `${element.top}px`,
    left: `${element.left}px`,
    width: '32px',
    height: `${height}px`,
  }}
>
  <a href={getRecipeSiteUrl(fluid.site, fluid.url)} aria-label={`${fluid.name}, ${amount}`}>
    <div
      style={{
        position: 'relative',
        width: '32px',
        height: `${height}px`,
      }}
      title={`${fluid.name}<br />${amount}`}
      data-uk-tooltip="{pos: 'top', offset: 4}"
    >
      <div
        style={{
          position: 'absolute',
          bottom: '0',
          width: '32px',
          height: `${fill}%`,
          minHeight: '2px',
          backgroundImage: `url('${fluidSprite.src}')`,
        }}
      ></div>
    </div>
  </a>
</div>

<div
  style={{
    position: 'absolute',
    top: `${element.top}px`,
    left: `${element.left}px`,
    width: '32px',
    height: `${height}px`,
    background: `url('${background}')`,
    backgroundPosition: `-${element.gauge}px -0px`,
    pointerEvents: 'none',
  }}
></div>
