---
import type { Item, RecipeSlotData } from '../../../mods/types.ts';
import GameImage from '../GameImage.astro';

interface Props {
  data: RecipeSlotData | undefined;
  top: number;
  left: number;
}

const { data, top, left } = Astro.props;

let items: Item[] = [];

if (data !== undefined) {
  if (data.itemGroup !== undefined) {
    items = data.itemGroup.items;
  } else {
    items = Array.isArray(data.item) ? data.item : [data.item];
  }
}

const amount = data?.amount ?? 1;
---

{data !== undefined && (
  <div
    style={{
      position: 'absolute',
      top: `${top}px`,
      left: `${left}px`,
      width: '32px',
      height: '32px',
    }}
  >
    <div class:list={['cofh-cycle', { random: data.randomCycle }]}>
      {items.map((item, index) => {
        const Link = item.href === undefined ? 'span' : 'a';

        return (
          <div class:list={{ hidden: index > 0 }}>
            <Link href={item.href} aria-label={item.href !== undefined ? item.name : undefined}>
              <div title={item.name} data-uk-tooltip="{pos: 'top', offset: 4}">
                <GameImage image={item.slotImage ?? item.image} height={32} alt={item.name} />
              </div>
            </Link>
          </div>
        );
      })}
    </div>

    {amount > 1 && <span class="cofh-recipe-slot-amount">{amount.toLocaleString('en-US')}</span>}
  </div>
)}

<script>
  import '../../../scripts/cycle.ts';
</script>
