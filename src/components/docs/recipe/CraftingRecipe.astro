---
import { getImage } from 'astro:assets';

import type { CraftingRecipeData } from '../../../data/types.ts';
import { image } from '../../../lib/images.ts';
import Slot from './Slot.astro';

interface Props {
  data: CraftingRecipeData;
}

const { data } = Astro.props;

const background = await getImage({ src: image('recipe/types/crafting.png') });

const position = (index: number) => index * 36 + 10;
---

<div
  style={{
    position: 'relative',
    width: '236px',
    height: '124px',
    background: `url('${background.src}')`,
  }}
>
  {data.rows.map((row, rowIndex) =>
    row.map(
      (cell, colIndex) =>
        cell && <Slot data={cell} top={position(rowIndex)} left={position(colIndex)} />,
    ),
  )}

  <Slot data={data.result} top={46} left={186} />

  {data.shapeless && (
    <div class="cofh-recipe-floating-text" style="top: 8px; right: 8px; text-align: right">
      Shapeless
    </div>
  )}
</div>
