---
import { getImage } from 'astro:assets';

import type { MachineRecipeData, MachineRecipeLayout } from '../../../data/types.ts';
import { image } from '../../../lib/images.ts';
import Slot from './Slot.astro';
import Tank from './Tank.astro';

interface Props {
  layout: MachineRecipeLayout;
  data: MachineRecipeData;
}

const { layout, data } = Astro.props;

const background = await getImage({ src: image(`recipe/types/${layout.background}.png`) });
---

<div
  style={{
    position: 'relative',
    width: `${layout.width}px`,
    height: `${layout.height}px`,
    background: `url('${background.src}')`,
  }}
>
  {layout.elements.map((element) => {
    if ('slot' in element) {
      const slot = data[element.slot];

      return (
        typeof slot === 'object' &&
        !('fluid' in slot) && <Slot data={slot} top={element.top} left={element.left} />
      );
    }

    if ('tank' in element) {
      const tank = data[element.tank];

      return (
        typeof tank === 'object' &&
        'fluid' in tank && <Tank data={tank} element={element} background={background.src} />
      );
    }

    const value = data[element.label];

    return (
      typeof value === 'number' && (
        <div
          class="cofh-recipe-floating-text"
          style={{
            top: `${element.top}px`,
            right: `${element.right}px`,
            textAlign: `${element.align}`,
          }}
        >
          {value}%
        </div>
      )
    );
  })}
</div>
