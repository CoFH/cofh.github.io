---
import type {
  Recipe,
  RecipeColumnItemData,
  RecipeSlotData,
  RecipeTankData,
} from '../../../mods/types.ts';
import Icon from '../../Icon.astro';
import RecipeColumnItem from './RecipeColumnItem.astro';

interface Props {
  recipes: Recipe[];
  noResult?: boolean;
}

const type = Astro.props.recipes[0].type;

if (Astro.props.recipes.some((recipe) => recipe.type !== type)) {
  const types = new Set(Astro.props.recipes.map((recipe) => recipe.type.name));

  throw new Error(
    `RecipeTable only supports one recipe type at a time, but got ${types.size}: ${[...types].join(', ')}.`,
  );
}

const withNote = Astro.props.recipes.some((recipe) => recipe.note !== undefined);

const collapseFromRecipeCount = 8;
const collapsedRecipeCount = 3;

const collapsible = Astro.props.recipes.length >= collapseFromRecipeCount;
const hiddenRecipeCount = Astro.props.recipes.length - collapsedRecipeCount;

const columnCount = 2 + Number(!Astro.props.noResult) + Number(type.withEnergy) + Number(withNote);

function asColumnItem(input: RecipeSlotData | RecipeTankData): RecipeColumnItemData {
  if ('fluid' in input) {
    return { fluid: input.fluid, fluidAmount: input.amount };
  }

  if (input.itemGroup !== undefined) {
    return { itemGroup: input.itemGroup };
  }

  return { item: Array.isArray(input.item) ? input.item[0] : input.item };
}

function getResultsColumnItems(recipe: Recipe): RecipeColumnItemData[] {
  if (recipe.results !== undefined) {
    return recipe.results;
  }

  return recipe.outputs
    .filter((output) => output !== null)
    .map((output) => {
      const columnItem = asColumnItem(output);

      if (recipe.amountSuffix && !('fluid' in output) && (output.amount ?? 1) > 1) {
        columnItem.suffix = `x${output.amount}`;
      }

      return columnItem;
    });
}

function getIngredientsColumnItems(recipe: Recipe): RecipeColumnItemData[] {
  if (recipe.ingredients !== undefined) {
    return recipe.ingredients;
  }

  const columnItems = recipe.inputs.filter((input) => input !== null).map(asColumnItem);

  const getTarget = (columnItem: RecipeColumnItemData) =>
    columnItem.item ?? columnItem.itemGroup ?? columnItem.fluid;

  return columnItems.filter(
    (columnItem, index) =>
      columnItems.findIndex((other) => getTarget(other) === getTarget(columnItem)) === index,
  );
}
---

<div class="table-scroll">
  <table class:list={['recipes', { collapsed: collapsible }]}>
    <thead data-pagefind-ignore="all">
      <tr>
        {!Astro.props.noResult && <th>Result(s)</th>}
        <th>Ingredients</th>
        {type.withEnergy && <th>Energy</th>}
        <th>
          <a href={type.href}>{type.name}</a> recipe
        </th>
        {withNote && <th>Note</th>}
      </tr>
    </thead>

    <tbody>
      {Astro.props.recipes.map((recipe, index) => {
        const ingredients = getIngredientsColumnItems(recipe);

        return (
          <tr
            class:list={{
              fade: index === collapsedRecipeCount - 1,
              extra: index >= collapsedRecipeCount,
            }}
          >
            {!Astro.props.noResult && (
              <td class="result">
                {getResultsColumnItems(recipe).map((result, index) => {
                  const Emphasis = type.allResultsBold || index === 0 ? 'strong' : Fragment;

                  return (
                    <>
                      <Emphasis>
                        <RecipeColumnItem data={result} role="result" first={index === 0} />
                      </Emphasis>
                      <br />
                    </>
                  );
                })}
              </td>
            )}

            <td>
              {ingredients.map((ingredient, index) => (
                <>
                  <RecipeColumnItem data={ingredient} role="ingredient" first={index === 0} />
                  {index < ingredients.length - 1 && <>&nbsp;+</>}
                  <br />
                </>
              ))}
            </td>

            {type.withEnergy && <td class="energy">{recipe.energy?.toLocaleString('en-US')} RF</td>}

            <td class="frame">
              <div class="recipe">
                <type.component recipe={recipe} />
              </div>
            </td>

            {withNote && <td>{recipe.note}</td>}
          </tr>
        );
      })}
    </tbody>

    {collapsible && (
      <tfoot data-pagefind-ignore="all">
        <tr>
          <td colspan={columnCount}>
            <button type="button" class="btn btn-quiet recipe-toggle" aria-expanded="false">
              <span>Show {hiddenRecipeCount} more recipes</span>
              <Icon name="chevronDown" />
            </button>
          </td>
        </tr>
      </tfoot>
    )}
  </table>
</div>

<style>
  .recipes {
    overflow: clip;
    font-size: 14px;
  }

  .result {
    text-align: center;
    white-space: nowrap;
  }

  .energy {
    text-align: right;
    white-space: nowrap;
  }

  .frame {
    padding: 8px;
    text-align: center;
  }

  .recipe {
    display: inline-block;
    font-size: 11px;
    line-height: 16px;
    vertical-align: top;
  }

  .recipe > :global(div) {
    border-radius: var(--radius-sm);
    box-shadow: 0 0 0 1px var(--line);
    filter: var(--recipe-filter);
  }

  .recipe :global(a:focus-visible) {
    outline-offset: 0;
  }

  .collapsed .extra {
    visibility: collapse;
  }

  .collapsed .fade td {
    position: relative;
  }

  .collapsed .fade td::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 15%, var(--bg));
    pointer-events: none;
  }

  tfoot td {
    padding: 14px;
    border-top: 1px solid var(--line-strong);
    border-radius: 0 0 calc(var(--radius-lg) - 1px) calc(var(--radius-lg) - 1px);
    background: var(--surface);
    text-align: center;
  }

  .recipe-toggle :global(.icon) {
    width: 13px;
    height: 13px;
  }

  .recipe-toggle[aria-expanded='true'] :global(.icon) {
    transform: rotate(180deg);
  }

  .recipe :global(.recipe-floating-text) {
    position: absolute;
    min-width: 100px;
    color: #6f6f6f;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13px;
  }
</style>

<script>
  // Pause the cycling slots of a recipe while the pointer is over it
  document.querySelectorAll('.recipe').forEach((recipe) => {
    recipe.addEventListener('mouseenter', () => {
      recipe.querySelectorAll('.cycle').forEach((cycle) => cycle.classList.add('paused'));
    });

    recipe.addEventListener('mouseleave', () => {
      recipe.querySelectorAll('.cycle').forEach((cycle) => cycle.classList.remove('paused'));
    });
  });

  // Toggle long recipe tables between their first few recipes and all of them
  document.querySelectorAll<HTMLButtonElement>('.recipe-toggle').forEach((button) => {
    const table = button.closest('table') as HTMLTableElement;
    const label = button.firstElementChild as HTMLSpanElement;
    const collapsedLabel = label.textContent;

    button.addEventListener('click', () => {
      const top = button.getBoundingClientRect().top;
      const expanded = !table.classList.toggle('collapsed');

      button.setAttribute('aria-expanded', String(expanded));
      label.textContent = expanded ? 'Show fewer' : collapsedLabel;

      // Keep the button where it was clicked when collapsing pulls it up the page
      if (!expanded) {
        window.scrollBy({ top: button.getBoundingClientRect().top - top, behavior: 'instant' });
      }
    });
  });
</script>
