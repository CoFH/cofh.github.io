---
import type { Item } from '../../../mods/types.ts';
import GameImage from '../GameImage.astro';

interface Props {
  item: Item;
}

const { item } = Astro.props;

const Link = item.href !== undefined ? 'a' : 'span';
---

<Link
  class="slot-item"
  href={item.href}
  aria-label={item.href !== undefined ? item.name : undefined}
  data-tooltip={item.name}
>
  <GameImage image={item.slotImage ?? item.image} height={32} alt={item.name} />
</Link>

<style>
  .slot-item {
    display: block;
    width: 32px;
    height: 32px;
  }
</style>
