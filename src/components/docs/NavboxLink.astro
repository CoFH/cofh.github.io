---
import type { ImageMetadata } from 'astro';

import NavboxIcon from './NavboxIcon.astro';

interface Props {
  href: string | undefined;
  text: string;
  icon: ImageMetadata | undefined;
}

const { href, text, icon } = Astro.props;

const isCurrent = href === Astro.url.pathname.replace(/\/?$/, '/');
---

{isCurrent ? (
  <span class="uk-text-bold cofh-nowrap">
    <NavboxIcon icon={icon} /> <span>{text}</span>
  </span>
) : (
  <a href={href} class:list={['cofh-navbox-link', { 'uk-text-danger': href === undefined }]}>
    <NavboxIcon icon={icon} /> <span>{text}</span>
  </a>
)}
