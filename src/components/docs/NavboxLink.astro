---
import type { ImageMetadata } from 'astro';

import NavboxIcon from './NavboxIcon.astro';

interface Props {
  href: string | undefined;
  text: string;
  icon: ImageMetadata | undefined;
}

const { href, text, icon } = Astro.props;

const isCurrent = href === Astro.url.pathname.replace(/\/?$/, '/');
---

{isCurrent ? (
  <span class="current">
    <NavboxIcon icon={icon} />
    <span>{text}</span>
  </span>
) : (
  <a href={href} class:list={{ missing: href === undefined }}>
    <NavboxIcon icon={icon} />
    <span>{text}</span>
  </a>
)}

<style>
  a {
    white-space: nowrap;
  }

  a:hover {
    text-decoration: none;
  }

  a:hover > span {
    text-decoration: underline;
  }

  .current {
    color: var(--fg-strong);
    font-weight: 700;
    white-space: nowrap;
  }

  .missing {
    color: var(--danger);
  }
</style>
