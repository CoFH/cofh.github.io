---
import { findImage } from '../../mods/define.ts';
import type { DocNavItem } from '../../mods/types.ts';
import NavboxIcon from './NavboxIcon.astro';
import NavboxLink from './NavboxLink.astro';

interface Props {
  item: DocNavItem;
  path: string;
}

const { item, path } = Astro.props;

const subitems = item.subitems ?? [];

const title = item.title ?? item.item?.name ?? '';

const href = item.url !== undefined ? `/docs/${path}/${item.url}` : item.item?.href;

const icon =
  item.item !== undefined
    ? (item.item.iconImage ?? item.item.image)
    : item.url !== undefined
      ? findImage(path, item.url.replace(/\/$/, '').replace(/^.*\//, ''), 'icon')
      : undefined;
---

{subitems.length > 0 && item.url === undefined && item.item === undefined ? (
  <span class="cofh-nowrap">
    <NavboxIcon icon={icon} /> {title}
  </span>
) : (
  <NavboxLink href={href} text={title} icon={icon} />
)}

{subitems.length > 0 && (
  <>
    {' '}
    <span>
      (
      {subitems.map((subitem, index) => (
        <>
          {index > 0 && (
            <>
              {' '}
              <span class="uk-text-bold">&#8729;</span>{' '}
            </>
          )}
          <Astro.self item={subitem} path={path} />
        </>
      ))}
      )
    </span>
  </>
)}
