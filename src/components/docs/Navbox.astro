---
import { getDocsHref, getDocsSections, getModsHref } from '../../lib/mods.ts';
import type { DocNav, ModListVersion } from '../../mods/types.ts';
import NavboxLink from './NavboxLink.astro';
import NavboxTable from './NavboxTable.astro';

interface Props {
  version: ModListVersion;
  currentMod: string | undefined;
}

const { version, currentMod } = Astro.props;

const navs = import.meta.glob<DocNav>('../../mods/*/*/navbox.ts', {
  eager: true,
  import: 'default',
});

const getNav = (slug: string) => navs[`../../mods/${version.mc}/${slug}/navbox.ts`];

const sections = (await getDocsSections(version))
  .map((section) => ({
    ...section,
    mods: section.mods.filter((mod) => getNav(mod.slug) !== undefined),
  }))
  .filter((section) => section.mods.length > 0);
---

<section
  class="navbox panel"
  aria-label={`Minecraft ${version.label} docs`}
  data-pagefind-ignore="all"
>
  <div class="head">
    <div class="version">
      <span class="label small-label" aria-hidden="true">
        Minecraft
      </span>
      <a href={getModsHref(version)} aria-label={`Mods for Minecraft ${version.label}`}>
        {version.label}
      </a>
    </div>

    <div class="tabs">
      {sections.map((section) => (
        <div class="family">
          <span class="label small-label" aria-hidden="true">
            {section.title}
          </span>

          <span class="family-tabs">
            {section.mods.map((mod) => (
              <button
                type="button"
                class="tab"
                aria-controls={`navbox-panel-${mod.slug}`}
                aria-expanded={mod.slug === currentMod ? 'true' : 'false'}
                aria-label={mod.title}
              >
                {mod.shortTitle ?? mod.title}
              </button>
            ))}
          </span>
        </div>
      ))}
    </div>
  </div>

  {sections
    .flatMap((section) => section.mods)
    .map((mod) => (
      <div id={`navbox-panel-${mod.slug}`} hidden={mod.slug !== currentMod}>
        <div class="caption">
          <NavboxLink href={getDocsHref(version, mod)} text={mod.title} icon={undefined} />
        </div>

        <NavboxTable nav={getNav(mod.slug)} path={`${version.mc}/${mod.slug}`} />
      </div>
    ))}
</section>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.navbox .tab')];

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((other) => {
        const expanded = other === tab;

        other.setAttribute('aria-expanded', String(expanded));
        document.getElementById(other.getAttribute('aria-controls')!)!.hidden = !expanded;
      });
    });
  });
</script>

<style>
  .navbox {
    overflow: hidden;
  }

  .head {
    display: flex;
    gap: 12px;
    padding: 8px 12px;
  }

  .version {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding-right: 12px;
    border-right: 1px solid var(--line-strong);
    line-height: 26px;
  }

  .version a {
    font-size: 14px;
    font-weight: 700;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    min-width: 0;
  }

  .family {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    min-width: 0;
  }

  .label {
    color: var(--faint);
    font-size: 11.5px;
    white-space: nowrap;
  }

  .family-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .tab {
    height: 26px;
    padding: 0 9px;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--fg);
    font-size: 13.5px;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
  }

  .tab:hover {
    background: var(--band-hover);
    color: var(--fg-strong);
  }

  .tab[aria-expanded='true'] {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }

  .caption {
    margin: 2px 2px 0;
    padding: 5px 12px;
    background: var(--line-strong);
    font-size: 13.5px;
    font-weight: 700;
    line-height: 20px;
    text-align: center;
  }
</style>
