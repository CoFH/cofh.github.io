---
import type { Recipe } from '../../../../../data/types.ts';
import { asSlot } from '../../../recipe/narrow.ts';
import RecipeFrame from '../../../recipe/RecipeFrame.astro';
import Slot from '../../../recipe/Slot.astro';
import background from './compactor.png';

interface Props {
  recipe: Recipe;
}

const { recipe } = Astro.props;
---

<RecipeFrame background={background}>
  <Slot data={asSlot(recipe.inputs[0])} top={10} left={10} />
  <Slot data={asSlot(recipe.outputs[0])} top={28} left={114} />
</RecipeFrame>
