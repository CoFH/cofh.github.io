---
import type { DocNavGroup } from '../../mods/types.ts';
import NavboxItem from './NavboxItem.astro';
import NavboxLink from './NavboxLink.astro';

interface Props {
  group: DocNavGroup;
  path: string;
}

const { group, path } = Astro.props;
const subgroups = group.groups ?? [];
const items = group.items ?? [];
---

<tr>
  {group.title !== undefined && (
    <th class="cofh-navbox-group-title">
      {group.url !== undefined ? (
        <NavboxLink href={`/docs/${path}/${group.url}`} text={group.title} icon={undefined} />
      ) : (
        group.title
      )}
    </th>
  )}

  <td
    colspan={group.title === undefined ? 2 : undefined}
    class:list={[
      group.title !== undefined && subgroups.length > 0
        ? 'cofh-navbox-group-subgroups-container'
        : 'cofh-navbox-group-items',
      { 'uk-text-center': group.title === undefined },
    ]}
  >
    {items.length > 0 && (
      <div style={subgroups.length > 0 ? 'padding: 2px' : undefined}>
        {items.map((item, index) => (
          <>
            {index > 0 && (
              <>
                {' '}
                <span class="uk-text-bold">&#8729;</span>{' '}
              </>
            )}
            <NavboxItem item={item} path={path} />
          </>
        ))}
      </div>
    )}

    {subgroups.length > 0 && (
      <table class="uk-table cofh-navbox-table cofh-navbox-subgroups-table">
        <tbody>
          {subgroups.map((subgroup) => (
            <Astro.self group={subgroup} path={path} />
          ))}
        </tbody>
      </table>
    )}
  </td>
</tr>
