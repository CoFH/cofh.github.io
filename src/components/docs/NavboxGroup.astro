---
import type { DocNavGroup } from '../../mods/types.ts';
import NavboxItem from './NavboxItem.astro';
import NavboxLink from './NavboxLink.astro';

interface Props {
  group: DocNavGroup;
  path: string;
}

const { group, path } = Astro.props;
const subgroups = group.groups ?? [];
const items = group.items ?? [];
---

<tr>
  {group.title !== undefined && (
    <th class="group-title">
      {group.url !== undefined ? (
        <NavboxLink href={`/docs/${path}/${group.url}`} text={group.title} icon={undefined} />
      ) : (
        group.title
      )}
    </th>
  )}

  <td
    colspan={group.title !== undefined ? undefined : 2}
    class:list={[
      group.title !== undefined && subgroups.length > 0 ? 'subgroups' : 'items',
      { centered: group.title === undefined },
    ]}
  >
    {items.length > 0 && (
      <div class="list">
        {items.map((item) => (
          <>
            <span class="item">
              <NavboxItem item={item} path={path} />
            </span>{' '}
          </>
        ))}
      </div>
    )}

    {subgroups.length > 0 && (
      <table class="subgroups-table">
        <tbody>
          {subgroups.map((subgroup) => (
            <Astro.self group={subgroup} path={path} />
          ))}
        </tbody>
      </table>
    )}
  </td>
</tr>

<style>
  .group-title {
    width: 1%;
    padding: 3px 12px;
    background: var(--band);
    color: var(--fg-strong);
    font-weight: 600;
    text-align: right;
    vertical-align: middle;
    white-space: nowrap;
  }

  .items {
    padding: 3px 12px;
  }

  .subgroups {
    padding: 0;
  }

  .centered {
    text-align: center;
  }

  .list {
    margin-left: -12px;
    line-height: 24px;
    clip-path: inset(-4px -4px -4px 8px);
  }

  .subgroups > .list {
    margin: 3px 12px 3px 0;
  }

  .item {
    white-space: nowrap;
  }

  .item::before,
  .item :global(.subitem + .subitem)::before {
    content: '\2219';
    display: inline-block;
    width: 8px;
    margin-right: 4px;
    color: var(--faint);
    font-weight: 700;
    text-align: center;
  }

  .centered .list {
    margin-left: 0;
    clip-path: none;
  }

  .centered .item:first-child::before {
    display: none;
  }

  .subgroups-table {
    width: calc(100% + 4px);
    margin: -2px;
    border-spacing: 2px;
  }

  .subgroups-table .group-title {
    background: var(--surface-2);
  }
</style>
