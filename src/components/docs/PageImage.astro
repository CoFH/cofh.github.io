---
import type { ImageMetadata } from 'astro';

import type { Fluid, Item } from '../../data/types.ts';
import GameImage from './GameImage.astro';

interface Props {
  images: PageImageEntry[];
  height?: number;
}

type PageImageEntry =
  | {
      item: Item | Fluid;
      image?: never;
      alt?: never;
    }
  | {
      image: ImageMetadata;
      alt: string;
      item?: never;
    };

const { images, height = 128 } = Astro.props;

const imageOf = (entry: PageImageEntry) =>
  entry.item !== undefined ? entry.item.image : entry.image;

const altOf = (entry: PageImageEntry) => (entry.item !== undefined ? entry.item.name : entry.alt);
---

{images.length > 1 ? (
  <div class="cofh-cycle">
    {images.map((entry, index) => (
      <GameImage
        image={imageOf(entry)}
        height={height}
        alt={altOf(entry)}
        class:list={{ hidden: index > 0 }}
        loading="eager"
      />
    ))}
  </div>
) : (
  <GameImage image={imageOf(images[0])} height={height} alt={altOf(images[0])} loading="eager" />
)}

<script>
  import '../../scripts/cycle.ts';
</script>
