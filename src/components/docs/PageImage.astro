---
import type { ImageMetadata } from 'astro';

import type { Fluid, Item } from '../../mods/types.ts';
import GameImage from './GameImage.astro';
import '../../scripts/cycle.css';

interface Props {
  images: PageImageEntry[];
  height?: number;
}

type PageImageEntry =
  | {
      item: Item | Fluid;
      image?: never;
      alt?: never;
    }
  | {
      image: ImageMetadata;
      alt: string;
      item?: never;
    };

const { images, height = 128 } = Astro.props;
---

<div class:list={['page-image', { cycle: images.length > 1 }]}>
  {images.map((entry, index) => (
    <GameImage
      image={entry.item !== undefined ? entry.item.image : entry.image}
      height={height}
      alt={entry.item !== undefined ? entry.item.name : entry.alt}
      class:list={{ hidden: index > 0 }}
      loading="eager"
    />
  ))}
</div>

<script>
  import '../../scripts/cycle.ts';
</script>

<style>
  .page-image {
    margin-bottom: 20px;
  }

  .page-image > :global(img) {
    max-width: 100%;
    vertical-align: top;
    width: auto;
  }
</style>
